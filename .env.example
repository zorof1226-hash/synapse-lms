# ==============================================================================
# Automated Study System Configuration (.env.example)
# ==============================================================================

# LLM API (Set GEMINI_API_KEY for Google Gemini, or OPENAI_API_KEY for OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Telegram Bot (Optional - for mobile quiz delivery)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LMS Configuration ('moodle', 'canvas', or 'folder')
LMS_TYPE=folder
MOODLE_URL=https://lms.university.edu
MOODLE_TOKEN=
MOODLE_SESSION_COOKIE=
MOODLE_VERIFY_SSL=true

CANVAS_URL=https://canvas.instructure.com
CANVAS_TOKEN=

# NotebookLM (Optional Layer)
NOTEBOOKLM_COOKIE=
NOTEBOOKLM_ENABLED=false

# Study Schedules
DAILY_SYNC_TIME=19:00
WEEKEND_QUIZ_DAYS=saturday,sunday
DAILY_MCQ_COUNT=20
DAILY_FLASHCARD_COUNT=25
WEEKEND_QUIZ_COUNT=25

# Web UI
WEB_HOST=127.0.0.1
WEB_PORT=8000
